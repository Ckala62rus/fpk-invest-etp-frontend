# Vite / SPA ЭТП — локальная разработка
# Скопируй: copy .env.example .env

# Прямой URL API (если без proxy). Для cookie Sanctum удобнее proxy — оставь пустым base.
# Axios по умолчанию ходит на относительный /api через Vite proxy.
VITE_API_BASE_URL=

# Куда Vite проксирует /api и /sanctum (nginx бэка в Docker)
VITE_API_PROXY_TARGET=http://localhost:8200

# Порт dev-сервера Vue
VITE_DEV_PORT=5173

# Origin SPA (для документации; Sanctum на бэке должен знать этот хост)
VITE_APP_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Laravel Echo + Reverb (тикер аукциона в реальном времени)
# ---------------------------------------------------------------------------
# 1) На бэке (backend/src/.env): BROADCAST_CONNECTION=reverb и блок REVERB_*
# 2) Контейнер: reverb-etp (порт 6001) — docker compose up -d reverb-etp
# 3) Здесь: VITE_REVERB_ENABLED=true и тот же APP_KEY, что REVERB_APP_KEY на бэке
# 4) Перезапустить Vite после правок: docker restart etp-frontend-dev
#
# Если Echo не нужен (только Postman / лог verifying_log):
#   VITE_REVERB_ENABLED=false
#   на бэке: BROADCAST_CONNECTION=verifying_log
#
# Без VITE_REVERB_APP_KEY Echo НЕ подключится (getEcho() вернёт null).
VITE_REVERB_ENABLED=true
VITE_REVERB_APP_KEY=local-etp-reverb-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=http

# Laravel Horizon (очереди) — ссылка в админке для super_admin
VITE_HORIZON_URL=http://localhost:8200/horizon
