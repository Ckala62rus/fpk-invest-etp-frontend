# Docker Compose — только фронтенд ЭТП (не зависит от backend compose)
# Скопируй: copy .env.example .env

COMPOSE_PROJECT_NAME=etp-frontend

# Порт nginx со статикой / (или vite в profile dev)
FRONTEND_HTTP_PORT=5173

# Куда nginx проксирует API на хосте (Ubuntu: api.domain.ru; локально: host.docker.internal:8200)
API_UPSTREAM=http://host.docker.internal:8200
